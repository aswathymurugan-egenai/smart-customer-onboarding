<mxfile host="axis">
  <diagram name="customer-registration-architecture" id="customer-registration-architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Customer registration architecture&lt;/b&gt;: deterministic rules decide 201 / 409 / 422, the model only advises" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="400" y="12" width="1100" height="30" as="geometry" /></mxCell>

        <!-- Actor -->
        <mxCell id="user" value="Registrant" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="155" y="12" width="30" height="50" as="geometry" /></mxCell>

        <!-- Panels -->
        <mxCell id="ui" value="CLOUD RUN · registration-ui&lt;br&gt;Next.js 15 · React 19 · App Router&lt;br&gt;SA registration-ui: no data roles" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=1.5;fillColor=#f4f8fd;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=10;fontColor=#2f5d8a;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="300" height="370" as="geometry" /></mxCell>
        <mxCell id="api" value="CLOUD RUN · registration-api (FastAPI)&lt;br&gt;SA registration-api · the deployment itself is a dependency outside this repo" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=1.5;fillColor=#fcfcfc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=10;fontColor=#2f5d8a;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="720" height="1030" as="geometry" /></mxCell>
        <mxCell id="dec" value="DETERMINISTIC DECISION PATH&lt;br&gt;alone decides 201 / 409 / 422, no model call on this path" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=1.5;fillColor=#f6fbf4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=10;fontColor=#2d6a1f;" vertex="1" parent="1"><mxGeometry x="610" y="100" width="490" height="520" as="geometry" /></mxCell>
        <mxCell id="adv" value="ADVISORY ONLY&lt;br&gt;model output becomes warnings, never a status code" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=1.5;fillColor=#fffbea;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=10;fontColor=#9a6b00;" vertex="1" parent="1"><mxGeometry x="610" y="650" width="490" height="410" as="geometry" /></mxCell>
        <mxCell id="adk" value="ADK ASSISTANT · app/agents/registration_agent.py" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;strokeWidth=1;fillColor=#fffdf3;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=10;fontColor=#9a6b00;" vertex="1" parent="1"><mxGeometry x="630" y="810" width="450" height="230" as="geometry" /></mxCell>
        <mxCell id="gcp" value="GOOGLE CLOUD PROJECT (one per environment)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=1.5;fillColor=#fcfcfc;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=10;fontColor=#6b4c85;" vertex="1" parent="1"><mxGeometry x="1460" y="60" width="500" height="1030" as="geometry" /></mxCell>
        <mxCell id="bq" value="BIGQUERY · dataset customer_ops" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;strokeWidth=1;fillColor=#f8f4fb;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=10;fontColor=#6b4c85;" vertex="1" parent="1"><mxGeometry x="1480" y="100" width="460" height="500" as="geometry" /></mxCell>
        <mxCell id="iam" value="SERVICE ACCOUNT registration-api · IAM roles (as the plan states)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;strokeWidth=1;fillColor=#f1f8f8;strokeColor=#5b9aa0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=10;fontColor=#2f6f75;" vertex="1" parent="1"><mxGeometry x="1480" y="790" width="460" height="190" as="geometry" /></mxCell>

        <!-- GCP hex icons (draw.io gcp2 library) -->
        <mxCell id="ui_icon" value="" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.gcp2.hexIcon;prIcon=cloud_run;fillColor=#dae8fc;strokeColor=#4285f4;" vertex="1" parent="1"><mxGeometry x="268" y="104" width="46" height="40" as="geometry" /></mxCell>
        <mxCell id="api_icon" value="" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.gcp2.hexIcon;prIcon=cloud_run;fillColor=#dae8fc;strokeColor=#4285f4;" vertex="1" parent="1"><mxGeometry x="1066" y="62" width="46" height="40" as="geometry" /></mxCell>
        <mxCell id="bq_icon" value="" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.gcp2.hexIcon;prIcon=bigquery;fillColor=#dae8fc;strokeColor=#4285f4;" vertex="1" parent="1"><mxGeometry x="1886" y="102" width="46" height="40" as="geometry" /></mxCell>
        <mxCell id="vtx_icon" value="" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.gcp2.hexIcon;prIcon=vertexai;fillColor=#dae8fc;strokeColor=#4285f4;" vertex="1" parent="1"><mxGeometry x="1866" y="684" width="60" height="52" as="geometry" /></mxCell>
        <mxCell id="sm_icon" value="" style="sketch=0;html=1;aspect=fixed;shape=mxgraph.gcp2.hexIcon;prIcon=secret_manager;fillColor=#dae8fc;strokeColor=#4285f4;" vertex="1" parent="1"><mxGeometry x="1866" y="1012" width="60" height="52" as="geometry" /></mxCell>

        <!-- UI -->
        <mxCell id="form" value="&lt;b&gt;Registration form&lt;/b&gt;&lt;br&gt;react-hook-form + zod, shadcn/ui Field layout&lt;br&gt;validates the email on blur and offers a typo suggestion&lt;br&gt;submits with an Idempotency-Key&lt;br&gt;201 card with warnings, 409 and 422 shown under the fields" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="260" height="150" as="geometry" /></mxCell>
        <mxCell id="asst" value="&lt;b&gt;Assistant panel&lt;/b&gt;&lt;br&gt;chat, suggested actions, Confirm dialog&lt;br&gt;sends the form snapshot and the last result&lt;br&gt;Confirm click sends action = confirm_registration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="260" height="120" as="geometry" /></mxCell>

        <!-- Routes -->
        <mxCell id="rlabel" value="&lt;b&gt;FASTAPI ROUTES&lt;/b&gt;&lt;br&gt;/api/v1 · problem+json errors" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#2f5d8a;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="180" height="34" as="geometry" /></mxCell>
        <mxCell id="r_reg" value="&lt;b&gt;POST /customers/register&lt;/b&gt;&lt;br&gt;201 · 403 · 409 · 422 · 429 · 503" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="420" y="140" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="r_val" value="&lt;b&gt;POST /customers/validate&lt;/b&gt;&lt;br&gt;200 verdict · 422 malformed body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="420" y="260" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="r_dup" value="&lt;b&gt;POST /customers/check-duplicate&lt;/b&gt;&lt;br&gt;200 exact_matches + warning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="420" y="548" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="r_chat" value="&lt;b&gt;POST /agent/chat&lt;/b&gt;&lt;br&gt;200 reply · 503 assistant-unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="420" y="895" width="170" height="60" as="geometry" /></mxCell>

        <!-- Decision path -->
        <mxCell id="s1" value="&lt;b&gt;Rate limit and bot check&lt;/b&gt;: per-client limit 429, bot verifier 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="630" y="150" width="450" height="40" as="geometry" /></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Normalize and validate the body&lt;/b&gt;: email, E.164 phone, tax ID, name; failures return 422" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="630" y="210" width="450" height="40" as="geometry" /></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Email rules&lt;/b&gt;: syntax and disposable-domain list; 422 email-invalid or email-disposable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="630" y="270" width="450" height="40" as="geometry" /></mxCell>
        <mxCell id="s4" value="&lt;b&gt;MX/DNS lookup&lt;/b&gt; (2 s): no MX and no A record is 422 email-domain-undeliverable; a timeout is mx_status unknown and registration continues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="630" y="330" width="450" height="40" as="geometry" /></mxCell>
        <mxCell id="s5" value="&lt;b&gt;RegistrationService&lt;/b&gt; runs the BigQuery transaction in a worker thread.&lt;br&gt;On LockConflict it retries up to 3 times with jitter within 10 s, then answers 503 registration-busy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="630" y="390" width="450" height="60" as="geometry" /></mxCell>
        <mxCell id="s6" value="&lt;b&gt;Outcome map&lt;/b&gt;: created 201 · replay 201 + Idempotent-Replayed · duplicate 409 with matched_on · key reuse 422.&lt;br&gt;Every non-created outcome appends an audit row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="630" y="470" width="450" height="56" as="geometry" /></mxCell>
        <mxCell id="s7" value="&lt;b&gt;check-duplicate exact match&lt;/b&gt;: email, phone, tax-ID hash (find_exact_matches.sql). Writes no customer; a found match is still 200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="630" y="550" width="450" height="56" as="geometry" /></mxCell>

        <!-- Advisory -->
        <mxCell id="a1" value="&lt;b&gt;Candidate pre-score&lt;/b&gt;&lt;br&gt;find_fuzzy_candidates.sql blocking, rapidfuzz scoring, top 5 sent as refs c1 to c5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="630" y="700" width="215" height="80" as="geometry" /></mxCell>
        <mxCell id="a2" value="&lt;b&gt;GeminiAdvisor&lt;/b&gt; (google-genai)&lt;br&gt;typo advice from the domain only, duplicate adjudication on refs; 4 s budget, ADVISOR_ENABLED switch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="870" y="700" width="215" height="80" as="geometry" /></mxCell>
        <mxCell id="llm" value="&lt;b&gt;LlmAgent registration_assistant&lt;/b&gt;&lt;br&gt;output_schema AssistantTurn, model from GEMINI_ASSISTANT_MODEL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="645" y="850" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="run" value="&lt;b&gt;Runner + InMemorySessionService&lt;/b&gt;&lt;br&gt;20 s turn budget, idle-session janitor, 1,000 sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="645" y="920" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="guard" value="&lt;b&gt;Guardrails in code&lt;/b&gt;: the API alone sets the confirm flag, 4 tool calls per turn, 30 turns per session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;fontColor=#1a1a1a;spacing=3;" vertex="1" parent="1"><mxGeometry x="645" y="990" width="200" height="44" as="geometry" /></mxCell>
        <mxCell id="t1" value="&lt;b&gt;validate_email_tool&lt;/b&gt;(email)&lt;br&gt;calls EmailValidationService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=9;fontColor=#1a1a1a;spacing=3;" vertex="1" parent="1"><mxGeometry x="865" y="848" width="200" height="42" as="geometry" /></mxCell>
        <mxCell id="t2" value="&lt;b&gt;detect_duplicate_customer_tool&lt;/b&gt;&lt;br&gt;(include_likely_duplicates)&lt;br&gt;calls DuplicateDetectionService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=9;fontColor=#1a1a1a;spacing=3;" vertex="1" parent="1"><mxGeometry x="865" y="894" width="200" height="42" as="geometry" /></mxCell>
        <mxCell id="t3" value="&lt;b&gt;register_customer_bq_tool&lt;/b&gt;()&lt;br&gt;takes no fields from the model; needs confirmation; calls RegistrationService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=9;fontColor=#1a1a1a;spacing=3;" vertex="1" parent="1"><mxGeometry x="865" y="940" width="200" height="42" as="geometry" /></mxCell>
        <mxCell id="fb" value="&lt;b&gt;OPTIONAL fallback agent&lt;/b&gt; on LiteLlm openai/gpt-4o; runs the turn when Gemini fails; OFF by default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=3 3;fontSize=9;fontColor=#1a1a1a;spacing=3;" vertex="1" parent="1"><mxGeometry x="865" y="990" width="200" height="44" as="geometry" /></mxCell>

        <!-- External -->
        <mxCell id="dns" value="&lt;b&gt;Public DNS resolvers&lt;/b&gt;&lt;br&gt;MX records, then A/AAAA (dnspython)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="1180" y="320" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="openai" value="&lt;b&gt;OpenAI GPT-4o&lt;/b&gt; (optional, OFF by default)&lt;br&gt;sees chat text and the redacted snapshot only when the fallback is on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=3 3;fontSize=9;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="1180" y="975" width="220" height="70" as="geometry" /></mxCell>

        <!-- BigQuery -->
        <mxCell id="cust" value="&lt;b&gt;customer_ops.customers&lt;/b&gt;&lt;br&gt;partition DATE(created_at), cluster email, normalized_name&lt;br&gt;email, phone_e164, tax_id_hash unique by the MERGE rule&lt;br&gt;no raw tax ID" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="1500" y="150" width="200" height="140" as="geometry" /></mxCell>
        <mxCell id="audit" value="&lt;b&gt;customer_ops.registration_audit_logs&lt;/b&gt;&lt;br&gt;append-only, HMAC hashes of email and client, no raw email, phone, tax ID, or IP" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="1730" y="150" width="190" height="140" as="geometry" /></mxCell>
        <mxCell id="txn" value="&lt;b&gt;register_customer.sql, one multi-statement transaction&lt;/b&gt;&lt;br&gt;1. BEGIN TRANSACTION&lt;br&gt;2. DELETE FROM customers WHERE FALSE (takes the table lock)&lt;br&gt;3. idempotency replay check on registration_audit_logs (24 h)&lt;br&gt;4. parameterized MERGE: insert only when no email, phone, or tax-ID hash matches&lt;br&gt;5. inserted: audit INSERT and COMMIT; matched: ROLLBACK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontColor=#1a1a1a;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1500" y="340" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="bqnote" value="Customer rows are written by DML query jobs only, never streaming inserts, so the lock covers every write. Every value is a query parameter. The exact-match, candidate, and audit queries run outside the lock." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#6b4c85;" vertex="1" parent="1"><mxGeometry x="1500" y="505" width="420" height="75" as="geometry" /></mxCell>

        <!-- Vertex, IAM, secrets -->
        <mxCell id="vtx" value="&lt;b&gt;Vertex AI · Gemini&lt;/b&gt; (genai.Client with vertexai=True; ADK Gemini)&lt;br&gt;GEMINI_ADVISOR_MODEL and GEMINI_ASSISTANT_MODEL default to gemini-2.5-flash, 2.5-pro selectable&lt;br&gt;? the plan lists the 2.5 models as retired on Vertex AI; endpoint availability is unverified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=9;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="1500" y="650" width="340" height="110" as="geometry" /></mxCell>
        <mxCell id="iam_text" value="roles/bigquery.dataEditor on the customer_ops dataset only&lt;br&gt;roles/bigquery.jobUser on the project&lt;br&gt;roles/aiplatform.user on the project&lt;br&gt;roles/secretmanager.secretAccessor on its own secrets&lt;br&gt;the default compute service account is never attached&lt;br&gt;registration-ui service account: no data roles" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1495" y="830" width="430" height="140" as="geometry" /></mxCell>
        <mxCell id="sm" value="&lt;b&gt;Secret Manager&lt;/b&gt;, mounted as volumes&lt;br&gt;pii-hash-key, bot-check secret (once a provider is chosen), OpenAI key only when the fallback is on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;fontColor=#1a1a1a;spacing=4;" vertex="1" parent="1"><mxGeometry x="1500" y="1000" width="340" height="75" as="geometry" /></mxCell>

        <!-- Left column notes -->
        <mxCell id="callout" value="&lt;b&gt;THE MODEL IS ADVISORY ONLY&lt;/b&gt;&lt;br&gt;Gemini, and the optional GPT-4o fallback, produce typo suggestions and likely-duplicate warnings. Warnings attach to a 201 or to the validate and check-duplicate responses. A model failure, timeout, or invalid output removes the advice and never changes 201, 409, or 422. The register tool takes no customer fields from the model, and the API alone sets the confirmation the tool checks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=10;fontColor=#1a1a1a;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="300" height="200" as="geometry" /></mxCell>
        <mxCell id="legend" value="LEGEND" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="710" width="300" height="290" as="geometry" /></mxCell>
        <mxCell id="lg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="35" y="742" width="24" height="14" as="geometry" /></mxCell>
        <mxCell id="lg1t" value="Browser UI and API routes" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="740" width="240" height="18" as="geometry" /></mxCell>
        <mxCell id="lg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="35" y="766" width="24" height="14" as="geometry" /></mxCell>
        <mxCell id="lg2t" value="Deterministic code and guardrails (decide the status)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="764" width="240" height="18" as="geometry" /></mxCell>
        <mxCell id="lg3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="35" y="790" width="24" height="14" as="geometry" /></mxCell>
        <mxCell id="lg3t" value="Advisory model path (warnings only)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="788" width="240" height="18" as="geometry" /></mxCell>
        <mxCell id="lg4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="814" width="24" height="14" as="geometry" /></mxCell>
        <mxCell id="lg4t" value="BigQuery tables and the registration transaction" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="812" width="240" height="18" as="geometry" /></mxCell>
        <mxCell id="lg5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="35" y="838" width="24" height="14" as="geometry" /></mxCell>
        <mxCell id="lg5t" value="External service or secret store" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="836" width="240" height="18" as="geometry" /></mxCell>
        <mxCell id="lg6" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="35" y="862" width="24" height="14" as="geometry" /></mxCell>
        <mxCell id="lg6t" value="Optional, OFF by default" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="860" width="240" height="18" as="geometry" /></mxCell>
        <mxCell id="lg7" value="&lt;font color=&quot;#2d6a1f&quot;&gt;&lt;b&gt;━━▶&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="884" width="34" height="18" as="geometry" /></mxCell>
        <mxCell id="lg7t" value="Solid arrow: request, decision, and data flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="884" width="240" height="18" as="geometry" /></mxCell>
        <mxCell id="lg8" value="&lt;font color=&quot;#b8860b&quot;&gt;&lt;b&gt;╌╌▶&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="908" width="34" height="18" as="geometry" /></mxCell>
        <mxCell id="lg8t" value="Dashed arrow: advisory flow, never sets a status" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="908" width="240" height="18" as="geometry" /></mxCell>
        <mxCell id="lgnote" value="Cloud service icons use the draw.io GCP set (mxgraph.gcp2), because the plan targets Google Cloud. Service accounts, IAM, and Secret Manager are dependencies the plan lists outside this repository; deployment is out of scope." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="32" y="934" width="276" height="60" as="geometry" /></mxCell>

        <!-- Edges: UI to API -->
        <mxCell id="e_user" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3b6ea5;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="ui"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_form_reg" value="POST register + Idempotency-Key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3b6ea5;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="form" target="r_reg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_form_val" value="POST validate on email blur" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3b6ea5;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="form" target="r_val"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_asst_chat" value="POST agent/chat: snapshot, last result, action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#3b6ea5;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="asst" target="r_chat"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="390" /><mxPoint x="360" y="925" /></Array></mxGeometry></mxCell>

        <!-- Edges: routes to services -->
        <mxCell id="e_reg_s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2d6a1f;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_reg" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_val_s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2d6a1f;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_val" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
