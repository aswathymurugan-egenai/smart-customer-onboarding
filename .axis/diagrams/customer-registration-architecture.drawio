        <!-- Edges: decision path to data and DNS -->
        <mxCell id="e_s4_dns" value="MX, then A/AAAA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2d6a1f;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="dns"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s5_txn" value="parameterized DML query job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7a4f9a;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="txn"><mxGeometry relative="1" as="geometry" /></mxCell>
