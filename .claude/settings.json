{
  "permissions": {
    "allow": [
      "Bash(find . -name)",
      "Bash(find . -name:*)",
      "Bash(find . -type)",
      "Bash(find . -type:*)",
      "Bash(gh)",
      "Bash(gh:*)",
      "Bash(git add)",
      "Bash(git add:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git remote -v)",
      "Bash(git remote -v:*)",
      "Bash(git rev-parse)",
      "Bash(git rev-parse:*)",
      "Bash(git show)",
      "Bash(git show:*)",
      "Bash(git stash list)",
      "Bash(git stash list:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(grep)",
      "Bash(grep:*)",
      "Bash(ls)",
      "Bash(ls:*)",
      "Bash(mkdir -p)",
      "Bash(mkdir -p:*)",
      "Bash(pwd)",
      "Bash(pwd:*)",
      "Bash(rg)",
      "Bash(rg:*)",
      "Bash(wc)",
      "Bash(wc:*)",
      "Edit(//private/tmp/claude-*/**/scratchpad/**)",
      "Edit(//tmp/claude-*/**/scratchpad/**)",
      "Edit(~/.claude/projects/**/memory/**)",
      "Read(//private/tmp/claude-*/**/scratchpad/**)",
      "Read(//tmp/claude-*/**/scratchpad/**)",
      "Read(~/.claude/projects/**/memory/**)",
      "WebFetch(domain:claude.ai)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:code.visualstudio.com)",
      "WebFetch(domain:developers.openai.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:downloads.claude.ai)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:learn.chatgpt.com)",
      "WebFetch(domain:opencode.ai)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(find * -delete)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /System)",
      "Bash(rm -rf /System:*)",
      "Bash(rm -rf /Users)",
      "Bash(rm -rf /Users:*)",
      "Bash(rm -rf /bin)",
      "Bash(rm -rf /bin:*)",
      "Bash(rm -rf /boot)",
      "Bash(rm -rf /boot:*)",
      "Bash(rm -rf /dev)",
      "Bash(rm -rf /dev:*)",
      "Bash(rm -rf /etc)",
      "Bash(rm -rf /etc:*)",
      "Bash(rm -rf /home)",
      "Bash(rm -rf /home:*)",
      "Bash(rm -rf /lib)",
      "Bash(rm -rf /lib:*)",
      "Bash(rm -rf /opt)",
      "Bash(rm -rf /opt:*)",
      "Bash(rm -rf /proc)",
      "Bash(rm -rf /proc:*)",
      "Bash(rm -rf /sbin)",
      "Bash(rm -rf /sbin:*)",
      "Bash(rm -rf /sys)",
      "Bash(rm -rf /sys:*)",
      "Bash(rm -rf /usr)",
      "Bash(rm -rf /usr:*)",
      "Bash(rm -rf /var)",
      "Bash(rm -rf /var:*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~:*)",
      "Edit(**/secrets/**)",
      "Edit(.axis/artifacts.json)",
      "Edit(.axis/policy/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(secrets/**)",
      "Read(**/secrets/**)",
      "Read(.axis/artifacts.json)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v axis >/dev/null 2>&1 || { echo 'axis is not installed on this machine, and this repo has a policy hook that needs it.' >&2; echo '  run: gcloud auth login' >&2; echo '  then: curl -fsSL https://axis.egen.dev/install.sh | sh' >&2; exit 2; }; axis guard --target claude"
          }
        ]
      }
    ]
  }
}
